[Unit]
Description=Othoba Performance HQ
After=network.target

[Service]
Type=simple
User=othoba
Group=othoba
WorkingDirectory=/opt/othoba
ExecStart=/usr/bin/node /opt/othoba/backend/server.mjs
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/othoba

[Install]
WantedBy=multi-user.target
